     test -n "$pm_tool" && test -f "$pm_tool" || continue
-    pm_elf=$(readlink -f "$pm_tool") || continue
-    printf 'GBS_TOOL %%s -> %%s\n' "$pm_tool" "$pm_elf"
+    pm_elf=$pm_tool
