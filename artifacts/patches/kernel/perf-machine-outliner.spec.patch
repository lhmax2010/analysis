 export MAKEFLAGS="${MAKEFLAGS:+$MAKEFLAGS }V=1"
+# PM12_KERNEL_TOOLS_BEGIN
+for pm_tool in mkdir cat clang ld.lld armv7l-tizen-linux-gnueabi-clang make grep sha256sum cut cp find xargs touch chmod sed rpm readelf; do
+    command -v "$pm_tool" >/dev/null || { echo "PM_BUILD_MISSING_TOOL $pm_tool" >&2; exit 2; }
+done
+# Local 0012f trial, instantiated once per GBS export.
+pm_lane=@LANE@
+export PM_KERNEL_LANE="$pm_lane"
+export PM_KERNEL_EVIDENCE="/var/tmp/pm0013d-evidence"
+pm_tools="%{_builddir}/.pm0012f-tools"
+mkdir -p "$pm_tools" || exit 2
+export PM_REAL_CLANG="$(command -v clang)" PM_REAL_MAKE="$(command -v make)"
+export PM_REAL_LLD="$(command -v ld.lld)"
+printf '%%s\n' "$PM_REAL_CLANG" > "$pm_tools/PM_REAL_CLANG" || exit 2
+printf '%%s\n' "$PM_REAL_MAKE" > "$pm_tools/PM_REAL_MAKE" || exit 2
+printf '%%s\n' "$PM_REAL_LLD" > "$pm_tools/PM_REAL_LLD" || exit 2
+printf '%%s\n' "$PM_KERNEL_LANE" > "$pm_tools/PM_KERNEL_LANE" || exit 2
+printf '%%s\n' "$PM_KERNEL_EVIDENCE" > "$pm_tools/PM_KERNEL_EVIDENCE" || exit 2
+cat > "$pm_tools/ld.lld" <<'PMLLD'
+#!/bin/sh
+IFS= read -r PM_REAL_LLD < "${0%%/*}/PM_REAL_LLD" || exit 2
+IFS= read -r pm_stage < "${0%%/*}/stage" || exit 2
+# Save the exact final link while cwd and response files still exist.
+prev=
+out=
+for arg do
+    if [ "$prev" = -o ]; then out=$arg; fi
+    case "$arg" in -o?*) out=${arg#-o};; esac
+    prev=$arg
+done
+if [ "${out##*/}" = vmlinux ]; then
+    set -e
+    dir=$out.pm0012k-link
+    mkdir -p "$dir"
+    printf '%%s\0' "$PM_REAL_LLD" "$@" > "$dir/argv"
+    echo "$pm_stage" > "$dir/rpm-stage"
+    pwd -P > "$dir/cwd"
+    "$PM_REAL_LLD" --version > "$dir/version"
+    i=0
+    for arg do
+        case "$arg" in @*) cp -- "${arg#@}" "$dir/rsp.$i";; esac
+        i=$((i+1))
+    done
+    "$PM_REAL_LLD" "$@"
+    readelf -nW "$out" > "$dir/output.notes"
+    sha256sum "$out" > "$dir/result.sha256"
+    exit 0
+fi
+exec "$PM_REAL_LLD" "$@"
+PMLLD
+cat > "$pm_tools/clang" <<'PMCLANG'
+#!/bin/sh
+IFS= read -r PM_REAL_CLANG < "${0%%/*}/PM_REAL_CLANG" || exit 2
+IFS= read -r pm_stage < "${0%%/*}/stage" || exit 2
+# Capture diagnostics only on the real scheduler TU, beside the output object.
+obj=
+prev=
+probe=
+for arg do
+    case "$arg" in kernel/sched/core.c|*/kernel/sched/core.c) probe=yes;; esac
+    if [ "$prev" = -o ]; then obj=$arg; fi
+    prev=$arg
+done
+if [ "$probe" = yes ] && [ -n "$obj" ]; then
+    "$PM_REAL_CLANG" "$@" -mllvm -print-all-options > "$obj.pm0012f-options" 2>&1
+    rc=$?
+    grep -E -- '^[[:space:]]*--?(enable-ml-inliner|regalloc-enable-advisor)[[:space:]]*=|warning:|error:' "$obj.pm0012f-options" >&2 || :
+    exit "$rc"
+fi
+exec "$PM_REAL_CLANG" "$@"
+PMCLANG
+cat > "$pm_tools/make" <<'PMMAKE'
+#!/bin/sh
+IFS= read -r PM_REAL_MAKE < "${0%%/*}/PM_REAL_MAKE" || exit 2
+IFS= read -r PM_KERNEL_LANE < "${0%%/*}/PM_KERNEL_LANE" || exit 2
+IFS= read -r PM_KERNEL_EVIDENCE < "${0%%/*}/PM_KERNEL_EVIDENCE" || exit 2
+IFS= read -r pm_stage < "${0%%/*}/stage" || exit 2
+# Scope the make override to Linux Kbuild. Keep any explicit incoming KCFLAGS.
+directory=$PWD
+prev=
+kc=${KCFLAGS-}
+for arg do
+    if [ "$prev" = -C ]; then directory=$arg; fi
+    case "$arg" in -C?*) directory=${arg#-C};; KCFLAGS=*) kc=${arg#KCFLAGS=};; esac
+    prev=$arg
+done
+if [ -f "$directory/arch/arm/Makefile" ] && [ -f "$directory/scripts/Kbuild.include" ]; then
+    case "$PM_KERNEL_LANE" in K1|K3|K5) set -- "$@" "KCFLAGS=${kc:+$kc }-moutline";; esac
+fi
+"$PM_REAL_MAKE" "$@" || exit $?
+# Some packaging steps clean the perf build tree before rpm exits.
+out=${KBUILD_OUTPUT:-.}
+for arg do case "$arg" in O=*) out=${arg#O=};; esac; done
+case "$out" in /*) tree=$out;; *) tree=$directory/$out;; esac
+if [ -s "$tree/arch/arm/boot/zImage" ] &&
+   [ -s "$tree/.config" ] && [ -s "$tree/vmlinux" ]; then
+    (
+        set -eu
+        cd "$tree"
+        hash=$(sha256sum arch/arm/boot/zImage | cut -d' ' -f1)
+        dest=$PM_KERNEL_EVIDENCE/$hash
+        test ! -e "$dest/complete" || exit 0
+        mkdir -p "$dest"
+        cp --parents -t "$dest" -- .config vmlinux System.map arch/arm/boot/zImage
+        for f in kernel/sched/core.o kernel/sched/core.o.pm0012f-options arch/arm/boot/Image; do
+            if [ -f "$f" ]; then cp --parents -t "$dest" -- "$f"; fi
+        done
+        if [ -d vmlinux.pm0012k-link ]; then cp -R vmlinux.pm0012k-link "$dest/"; fi
+        find . -type f -name '.*.o.cmd' -exec cp --parents -t "$dest" -- {} +
+        # Keep the individual ELF objects needed for caller attribution. Preserve NUL-delimited names.
+        find . -type f -name '*.o' -exec grep -alFZ OUTLINED_FUNCTION_ {} + > "$dest/candidates" || :
+        xargs -0 -r -a "$dest/candidates" cp --parents -t "$dest" --
+        touch "$dest/complete"
+    ) || exit $?
+fi
+PMMAKE
+chmod 755 "$pm_tools/make" "$pm_tools/clang" "$pm_tools/ld.lld"
+
+# PM12_KERNEL_TOOLS_END
+pm_tools="%{_builddir}/.pm0012f-tools"
+IFS= read -r pm_lane < "$pm_tools/PM_KERNEL_LANE" || exit 2
+IFS= read -r PM_REAL_CLANG < "$pm_tools/PM_REAL_CLANG" || exit 2
+case "$pm_lane" in K2|K3)
+    pm_def=linux-6.12/arch/arm/configs/KANTSU2E_perf_defconfig
+    grep -qx 'CONFIG_MLGO=y' "$pm_def" || exit 2
+    chmod u+w "$pm_def" || exit 2
+    sed -i 's/^CONFIG_MLGO=y$/# CONFIG_MLGO is not set/' "$pm_def" || exit 2
+    echo PM_KERNEL_PERF_DEFCONFIG_MLGO_OFF
+    ;;
+K4|K5)
+    pm_def=linux-6.12/arch/arm/configs/KANTSU2E_perf_defconfig
+    test -f "$pm_def" || exit 2
+    chmod u+w "$pm_def"
+    sed -i '/^# CONFIG_THUMB2_KERNEL is not set$/d' "$pm_def"
+    echo CONFIG_THUMB2_KERNEL=y >> "$pm_def"
+esac
 printf 'GBS_KERNEL_PATH %%s\n' "$PATH"
 rpm -q clang llvm clang-accel-x86_64-armv7l --qf 'GBS_RPM %%{NAME} %%{EPOCHNUM} %%{VERSION} %%{RELEASE} %%{ARCH}\n' || :
