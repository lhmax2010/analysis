+; RUN: llvm-as %s -o %t.o
+
+;; A module compiled without -fPIC (no "PIC Level" flag) marks its declarations
+;; dso_local. When the link produces a shared object or a PIE (PIC relocation
+;; model), a declaration the linker does not resolve inside the linkage unit
+;; loses dso_local, so that the reference goes through the GOT (otherwise the
+;; DSO does not link). This is the regular-LTO counterpart of the ThinLTO
+;; ClearDSOLocalOnDeclarations rule. Hidden visibility is implicitly dso_local
+;; and keeps the direct access; extern_weak is not (even hidden: the symbol may
+;; be absent at run time) and goes through the GOT; a non-prevailing
+;; linkonce_odr definition becomes available_externally, a declaration for the
+;; linker, and is treated the same way.
+; RUN: llvm-lto2 run %t.o -o %t.pic -relocation-model=pic -r=%t.o,main,plx -r=%t.o,foo, -r=%t.o,bar, -r=%t.o,ew, -r=%t.o,hew, -r=%t.o,ao,
+; RUN: llvm-readobj -r %t.pic.0 | FileCheck %s --check-prefix=PIC
+; PIC-DAG: R_X86_64_{{(REX_)?}}GOTPCRELX foo
+; PIC-DAG: R_X86_64_PC32 bar
+; PIC-DAG: R_X86_64_{{(REX_)?}}GOTPCRELX ew
+; PIC-DAG: R_X86_64_{{(REX_)?}}GOTPCRELX hew
+; PIC-DAG: R_X86_64_{{(REX_)?}}GOTPCRELX ao
+
+;; Static relocation model (an executable): nothing changes.
+; RUN: llvm-lto2 run %t.o -o %t.static -relocation-model=static -r=%t.o,main,plx -r=%t.o,foo, -r=%t.o,bar, -r=%t.o,ew, -r=%t.o,hew, -r=%t.o,ao,
+; RUN: llvm-readobj -r %t.static.0 | FileCheck %s --check-prefix=STATIC
+; STATIC-DAG: R_X86_64_PC32 foo
+; STATIC-DAG: R_X86_64_PC32 bar
+; STATIC-DAG: R_X86_64_PC32 ew
+; STATIC-DAG: R_X86_64_PC32 ao
+
+;; The linker reports a final definition of foo in the linkage unit ('l'):
+;; the direct access is kept.
+; RUN: llvm-lto2 run %t.o -o %t.local -relocation-model=pic -r=%t.o,main,plx -r=%t.o,foo,l -r=%t.o,bar, -r=%t.o,ew, -r=%t.o,hew, -r=%t.o,ao,
+; RUN: llvm-readobj -r %t.local.0 | FileCheck %s --check-prefix=LOCAL
