+;; -shared: a dso_local declaration from a non-PIC module must be accessed
+;; through the GOT (the ThinLTO ClearDSOLocalOnDeclarations rule applied to
+;; regular LTO); compare relocation-model-static.ll for the executable case.
+; RUN: %gold -m elf_x86_64 -shared -plugin %llvmshlibdir/LLVMgold%shlibext \
+; RUN:    --plugin-opt=save-temps %t.o -o %t-out.so
+; RUN: llvm-readobj -r %t-out.so.lto.o | FileCheck %s
+
+;; the gold plugin does not enable the GOTPCRELX relaxation, hence GOTPCREL (see relocation-model-pic.ll)
+; CHECK: R_X86_64_{{(REX_)?}}GOTPCREL{{X?}} foo
+
+;; The opt-in report reaches gold's diagnostic handler as a warning.
+; RUN: %gold -m elf_x86_64 -shared -plugin %llvmshlibdir/LLVMgold%shlibext \
